# Discord Application > Bot. Enable Server Members and Message Content intents.
DISCORD_TOKEN=
CLIENT_ID=
OWNER_1=
OWNER_2=
OWNER_3=
DEV_GUILD=
GLOBAL_DEPLOY=false
# Optional comma-separated deployment allowlist; empty allows ordinary servers.
ALLOWED_GUILD_IDS=
# Local dev DB mirrors production defaults (user/database discord_bot) on port 5433.
DATABASE_URL=postgresql://discord_bot:discord_bot_dev@localhost:5433/discord_bot
# Production Compose requires a random password. URL-encode special characters.
POSTGRES_PASSWORD=
HEALTH_PORT=3000
PRESENCE_INTERVAL_SECONDS=60
PRESENCES_JSON=[{"text":"/help","type":3,"enabled":true}]
# All ecosystem integrations are optional. URLs are operator-controlled origins.
NOVA_API_URL=https://login.eramos.us
NOVA_CLIENT_ID=discord-bot
# Register this exact HTTPS callback in Nova's discord-bot project.
NOVA_REDIRECT_URI=https://discord.eramos.us/oauth/nova/callback
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
MUNCHPOINTS_API_URL=https://mp.eramos.us
FLUX_API_URL=https://finance.eramos.us
APEX_API_URL=https://apex.eramos.us
ATLAS_API_URL=https://atlas.eramos.us
NEXUS_API_URL=https://eramos.us
ADMIN_API_URL=https://admin.eramos.us
# JSON object: source name -> secret of at least 32 random characters
EVENT_SIGNING_KEYS={}
# HTTPS endpoint used by each owning service to send signed user notifications.
# Each service receives a distinct source-specific signing key; never reuse the bot token.
DISCORD_BOT_EVENTS_URL=
# Optional health-path overrides, e.g. NOVA_HEALTH_PATH=/health
# Music: mount an operator-owned library of Opus .ogg/.webm files.
MUSIC_LIBRARY_DIR=
MUSIC_TRACKS_JSON={}
