# Discord Bot Environment Variables
# Copy this to .env and fill in your values

# Discord Bot Token (from Discord Developer Portal)
TOKEN=your_bot_token_here

# Owner IDs (Discord User IDs for owner-only commands)
OWNER_1=your_discord_user_id_1
OWNER_2=your_discord_user_id_2
OWNER_3=your_discord_user_id_3

# Optional: Nova Auth URL (if integrating with Nova)
# NOVA_URL=https://nova.yourdomain.com

# PostgreSQL Database (for guild settings persistence)
DATABASE_URL=postgresql://user:password@localhost:5432/discord_bot