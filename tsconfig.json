{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": ".",

    "paths": {
      "@config": ["src/config/index.ts"],
      "@config/*": ["src/config/*"],
      "@config/env": ["src/config/env.ts"],
      "@config/botConfig": ["src/config/botConfig.ts"],
      "@config/owners": ["src/config/owners.ts"],
      "@config/theme": ["src/config/theme.ts"],
      "@config/presences": ["src/config/presences.ts"],

      "@framework": ["src/framework/index.ts"],
      "@framework/*": ["src/framework/*"],

      "@events": ["src/events/index.ts"],
      "@events/*": ["src/events/*"],

      "@features": ["src/features/index.ts"],
      "@features/*": ["src/features/*"],

      "@types": ["src/types/index.ts"],
      "@types/*": ["src/types/*"],

      "@ui": ["src/ui/index.ts"],
      "@ui/*": ["src/ui/*"],

      "@utils": ["src/utils/index.ts"],
      "@utils/*": ["src/utils/*"],

      "@db": ["src/database/index.ts"],
      "@db/*": ["src/database/*"]
    }
  },

  "include": ["src"]
}