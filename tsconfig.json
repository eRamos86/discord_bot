{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "rootDir": "./src",
    "outDir": "./dist",

    "ignoreDeprecations": "6.0",

    "baseUrl": "./src",
    "paths": {
      "@config": ["config/index.ts"],
      "@config/*": ["config/*"],

      "@framework": ["framework/index.ts"],
      "@framework/*": ["framework/*"],

      "@events": ["events/index.ts"],
      "@events/*": ["events/*"],

      "@features": ["features/index.ts"],
      "@features/*": ["features/*"],

      "@types": ["types/index.ts"],
      "@types/*": ["types/*"],

      "@ui": ["ui/index.ts"],
      "@ui/*": ["ui/*"],

      "@utils": ["utils/index.ts"],
      "@utils/*": ["utils/*"],

      "@db": ["database/index.ts"],
      "@db/*": ["database/*"],
    }
  },

  "include": ["src"]
}
